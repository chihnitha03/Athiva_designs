{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/index.html", "destination": "/index.html" },
    { "source": "/auth.html", "destination": "/auth.html" },
    { "source": "/admin-login.html", "destination": "/admin-login.html" },
    { "source": "/admin-dashboard.html", "destination": "/admin-dashboard.html" },
    { "source": "/wishlist.html", "destination": "/wishlist.html" },
    { "source": "/profile.html", "destination": "/profile.html" },
    { "source": "/styles.css", "destination": "/styles.css" },
    { "source": "/script.js", "destination": "/script.js" },
    { "source": "/auth.js", "destination": "/auth.js" },
    { "source": "/admin-login.js", "destination": "/admin-login.js" },
    { "source": "/admin-dashboard.js", "destination": "/admin-dashboard.js" },
    { "source": "/wishlist.js", "destination": "/wishlist.js" },
    { "source": "/profile.js", "destination": "/profile.js" },
    { "source": "/logo.jpeg", "destination": "/logo.jpeg" },
    { "source": "/images/(.*)", "destination": "/images/$1" }
  ]
}
